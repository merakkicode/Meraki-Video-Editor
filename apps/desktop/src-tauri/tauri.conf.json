{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meraki Video Editor",
  "version": "1.0.0",
  "identifier": "org.merakkicode.Meraki",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meraki Video Editor",
        "width": 1520,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#10131d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://meraki-frame.localhost https://meraki-frame.localhost meraki-frame:; font-src 'self'; object-src 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Meraki Core Team",
    "copyright": "Copyright © 2026 Meraki Contributors",
    "category": "Video",
    "shortDescription": "A precise, expressive desktop video editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0"
  }
}
