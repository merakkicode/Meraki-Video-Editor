          "usr/share/fonts/truetype/dejavu": "/usr/share/fonts/truetype/dejavu",
          "usr/share/doc/fonts-dejavu-core/copyright": "/usr/share/doc/fonts-dejavu-core/copyright"
        }
      }
    },
    "resources": {
      "../../../LICENSE": "licenses/meraki/LICENSE",
      "../../../NOTICE": "licenses/meraki/NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/meraki/THIRD_PARTY_NOTICES.md"
