      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2",
          "libasound2-plugins",
          "libssl3",
          "libvulkan1",
          "fonts-dejavu-core"
